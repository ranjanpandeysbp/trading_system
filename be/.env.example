# =============================================================================
# Trading System API — environment template
# Copy to be/.env and edit. Values here are safe defaults for local dev.
# =============================================================================

# --- Database mode -----------------------------------------------------------
# sqlite  (default) → local file be/data/paper_trading.db  [current behaviour]
# mysql             → MySQL / MariaDB via MYSQL_* settings below
#
# If nothing is set, the app uses SQLite — same as today.
DB_MODE=sqlite

# Optional: full SQLAlchemy URL. When set, this OVERRIDES DB_MODE entirely.
# Examples:
#   DATABASE_URL=sqlite+aiosqlite:///C:/work/ranjan/ai/trading-app/trading_system/be/data/paper_trading.db
#   DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/trading_system?charset=utf8mb4
# DATABASE_URL=

# --- MySQL (only used when DB_MODE=mysql and DATABASE_URL is empty) -----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trading_system
MYSQL_CHARSET=utf8mb4

# Create the empty schema once before first MySQL boot:
#   CREATE DATABASE trading_system CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Then start the API — tables are created automatically via SQLAlchemy create_all.

# --- App ---------------------------------------------------------------------
DEBUG=true
# JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret

# Deep mode strategy details host (Strategies page at /strategies → API /api/v1/strategies)
# STRATEGIES_CATALOG_BASE_URL=http://31.97.237.200:2008

# --- AI providers (optional; Manage → AI Settings also stores keys in DB) ----
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# MODEL_NAME=gemini-2.0-flash

# Claude via Azure AI Foundry (AnthropicFoundry)
# CLAUDE_API_KEY=
# ANTHROPIC_FOUNDRY_API_KEY=
# CLAUDE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/anthropic
# CLAUDE_MODEL=claude-sonnet-5

# OpenAI via Azure AI Foundry
# OPENAI_API_KEY=
# OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# OPENAI_MODEL=gpt-5-nano

# IndMoney / INDstocks (Manage → Data Provider → IndMoney; TOTP auth)
# Setup: indstocks.com/app/api-trading/access-tokens → Setup TOTP
# INDMONEY_CLIENT_ID=
# INDMONEY_MPIN=
# INDMONEY_TOTP_SECRET=

# Groww Trading API (Manage → Data Provider → Groww; TOTP auth)
# Setup: Groww → Trading APIs → Generate TOTP token
# GROWW_API_KEY=
# GROWW_TOTP_SECRET=
